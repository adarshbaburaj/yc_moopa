DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Gemini: either an API key...
GOOGLE_API_KEY=
# ...or Vertex AI with your gcloud login (gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
GRANDSON_NAME=
GRANDSON_NUMBER=
BAND_NUMBER=
# Contacts the agent can call: aliases split by |, entries by ;
CONTACTS=Grandfather from NYC|grandpa:+1XXXXXXXXXX
# Optional tuning
LLM_PROVIDER=openai            # or gemini (Vertex AI)
BAND_TAP_THRESHOLD=0.5         # g; lower = more sensitive double-tap
FALL_IMPACT_G=1.6              # g; impact needed after free-fall (raise for real-world use)
FALL_STILL_S=4                 # seconds still after landing
MOOPA_MAX_LISTEN_S=120         # double-tap listening safety cap
MOOPA_HALO=1                   # 0 = no glowing border on the phone
